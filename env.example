# Copy to .env.test for `pnpm test:live` (the unit tests never need it).
SIGNOZ_LIVE=1
SIGNOZ_BASE_URL=https://signoz.example.com
# Preferred: a service account key (Settings → Service Accounts).
SIGNOZ_API_KEY=
# Or the browser session: DevTools → Application → Local Storage → AUTH_TOKEN / REFRESH_AUTH_TOKEN.
# SIGNOZ_AUTH_TOKEN=
# SIGNOZ_REFRESH_AUTH_TOKEN=
# SIGNOZ_ENV=production
# SIGNOZ_LIVE_SERVICE=point-api
# 1 = also create a test dashboard and delete it afterwards.
# SIGNOZ_LIVE_WRITE=0
